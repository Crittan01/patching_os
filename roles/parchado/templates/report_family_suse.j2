{
  "pre_validation": {{ previous_results.pre_validation | to_json }},
  "snapshot": {{ previous_results.snapshot | to_json }},
  "repo_config": {{ previous_results.repo_config | to_json }},
  "patching": {
    "status": "{{ 'OK' if (previous_results.pre_validation.can_continue and 
                          previous_results.repo_config.can_continue and 
                          not patch_error) else
                  'SKIPPED' if (not previous_results.pre_validation.can_continue or 
                              not previous_results.repo_config.can_continue) else 
                  'FAILED' }}",
    "can_continue": {{ (previous_results.pre_validation.can_continue and 
                       previous_results.repo_config.can_continue and 
                       not patch_error) | lower }},
    "timestamp": "{{ ansible_date_time.iso8601 }}",
    "errors": {{ patch_error | to_json }},
    "update_details": {
      "categories_selected": {{ paquetes_objetivo | default([]) | to_json }},
      "update_status": {{ update_result.update_status | default('NO_UPDATES_AVAILABLE') | to_json }},
      "changed": {{ zypper_update.changed | default(false) | bool | lower }}
    },
    "package_changes": {
      "total_antes": {{ paquetes_antes.stdout_lines | default([]) | length }},
      "total_despues": {{ paquetes_despues.stdout_lines | default([]) | length }},
      "estado": {{ paquetes_info.estado_actualizacion | default('NO_CHANGES') | to_json }},
      "nuevos": {% if paquetes_info.nuevos | default([]) | length > 0 %}
        {{ paquetes_info.nuevos | to_json }}
      {% else %}
        ""
      {% endif %},
      "eliminados": {% if paquetes_info.eliminados | default([]) | length > 0 %}
        {{ paquetes_info.eliminados | to_json }}
      {% else %}
        ""
      {% endif %},
      "actualizados": {
        "total": {{ paquetes_info.actualizados | default([]) | length }},
        "detalles": {{ paquetes_info.actualizados | default([]) | to_json }}
      }
    },
    "skipped_reason": "{{ 'Pre-validation failed' if not previous_results.pre_validation.can_continue else
                         'Repository configuration failed' if not previous_results.repo_config.can_continue else 
                         patch_error.pre_patch.error if patch_error.pre_patch is defined else
                         patch_error.patching.error if patch_error.patching is defined else '' }}"
  }
}