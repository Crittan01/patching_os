{
  "pre_validation": {{ previous_results.pre_validation | to_json }},
  "snapshot": {{ previous_results.snapshot | to_json }},
  "repo_config": {{ previous_results.repo_config | to_json }},
  "patching": {{ previous_results.patching | to_json }},
  "post_validation": {
    "status": "{{ 'SKIPPED' if not (previous_results.pre_validation.can_continue and
                                   previous_results.snapshot.can_continue and
                                   previous_results.repo_config.can_continue and
                                   previous_results.patching.can_continue) else
                 'FAILED' if (reboot_error is defined) else
                 'OK' }}",
    "can_continue": {{ (previous_results.pre_validation.can_continue and
                      previous_results.snapshot.can_continue and
                      previous_results.repo_config.can_continue and
                      previous_results.patching.can_continue) | lower }},
    "execution_state": "{{
      'REINICIO_FALLIDO' if reboot_error is defined else
      'COMPLETADO'
    }}",
    "timestamp": "{{ ansible_date_time.iso8601 }}",
    "final_reboot": {
      "required": {{ ansible_reboot_pending | default(false) | bool | lower }},
      "executed": {{ (reboot_check.changed | default(false)) | bool | lower }},
      "success": {{ (reboot_check is defined and not reboot_check.failed | default(true)) | bool | lower }}
    },
    "services": {
      "comparison": {
        "initial_count": {{ previous_results.pre_validation.services_initial.active_list | length }},
        "final_count": {{ active_services_final | length }},
        "final_list": {{ active_services_final | to_json }},
        "stopped_services": {{ service_analysis.stopped_services | to_json }},
        "new_active_services": {{ service_analysis.new_active_services | to_json }}
      },
      "recovery": {
        "attempted": {{ service_recovery_results.attempted | int }},
        "successful": {{ service_recovery_results.successful | int }},
        "failed": {{ service_recovery_results.failed | int }},
        "details": {{ service_recovery_results.details | to_json }},
        "service_issues": {
          "permission_denied": {{ service_recovery.results | default([]) |
            selectattr('msg', 'defined') |
            selectattr('msg', 'search', 'Access is denied') |
            map(attribute='item') |
            list | to_json }},
          "other_errors": {{ service_recovery.results | default([]) |
            selectattr('msg', 'defined') |
            rejectattr('msg', 'search', 'Access is denied') |
            map(attribute='item') |
            list | to_json }}
        }
      }
    },
    "skipped_reason": "{{ 'Pre-validation failed' if not previous_results.pre_validation.can_continue else
                        'Snapshot failed' if not previous_results.snapshot.can_continue else
                        'Repository configuration failed' if not previous_results.repo_config.can_continue else
                        'Patching failed' if not previous_results.patching.can_continue else '' }}"
  }
}