{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [

          {
            "type": "Container",
            "style": "{% if _overall_ok | bool %}good{% else %}attention{% endif %}",
            "items": [
              {
                "type": "ColumnSet",
                "columns": [
                  {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "Informe de Parchado · RHEL",
                        "size": "Small",
                        "weight": "Lighter",
                        "color": "Light",
                        "spacing": "None"
                      },
                      {
                        "type": "TextBlock",
                        "text": "{{ crq_input | upper }}",
                        "size": "ExtraLarge",
                        "weight": "Bolder",
                        "color": "Light",
                        "spacing": "None"
                      }
                    ]
                  },
                  {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "{% if _overall_ok | bool %}✔ EXITOSO{% else %}✖ FALLIDO{% endif %}",
                        "size": "Medium",
                        "weight": "Bolder",
                        "color": "Light",
                        "horizontalAlignment": "Right"
                      }
                    ]
                  }
                ]
              }
            ]
          },

          {
            "type": "ColumnSet",
            "spacing": "Medium",
            "columns": [
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "SERVIDOR",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "Accent",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ inventory_hostname }}",
                    "size": "Medium",
                    "weight": "Bolder",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ ip | default(ansible_host) }}",
                    "size": "Small",
                    "color": "Default",
                    "isSubtle": true,
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "SISTEMA OPERATIVO",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "Accent",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ ansible_distribution }} {{ ansible_distribution_major_version }}.{{ ansible_distribution_release | default('x') }}",
                    "size": "Small",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "LOTE",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "Accent",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ lote | default('N/A') }}",
                    "size": "Small",
                    "spacing": "None"
                  }
                ]
              }
            ]
          },

          {
            "type": "ColumnSet",
            "separator": true,
            "spacing": "Medium",
            "columns": [
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Validación Previa",
                    "size": "Small",
                    "weight": "Bolder",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.pre_validation.status }}",
                    "size": "Small",
                    "color": "{% if results.pre_validation.can_continue %}Good{% else %}Attention{% endif %}",
                    "weight": "Bolder",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Repositorios",
                    "size": "Small",
                    "weight": "Bolder",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.repo_config.status }}",
                    "size": "Small",
                    "color": "{% if results.repo_config.can_continue %}Good{% elif results.repo_config.status == 'SKIPPED' %}Warning{% else %}Attention{% endif %}",
                    "weight": "Bolder",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Parchado",
                    "size": "Small",
                    "weight": "Bolder",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.patching.status }}",
                    "size": "Small",
                    "color": "{% if results.patching.can_continue %}Good{% elif results.patching.status == 'SKIPPED' %}Warning{% else %}Attention{% endif %}",
                    "weight": "Bolder",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Validación Post",
                    "size": "Small",
                    "weight": "Bolder",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.post_validation.status }}",
                    "size": "Small",
                    "color": "{% if results.post_validation.can_continue %}Good{% elif results.post_validation.status == 'SKIPPED' %}Warning{% else %}Attention{% endif %}",
                    "weight": "Bolder",
                    "spacing": "None"
                  }
                ]
              }
            ]
          },

          {
            "type": "ColumnSet",
            "separator": true,
            "spacing": "Medium",
            "columns": [
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "PAQUETES ACTUALIZADOS",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "Accent",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.patching.package_changes.actualizados.total | default(0) }}",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "NUEVOS",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "Good",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.patching.package_changes.nuevos | default([]) | length }}",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "Good",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "ELIMINADOS",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "{% if results.patching.package_changes.eliminados | default([]) | length > 0 %}Warning{% else %}Default{% endif %}",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{{ results.patching.package_changes.eliminados | default([]) | length }}",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "{% if results.patching.package_changes.eliminados | default([]) | length > 0 %}Warning{% else %}Default{% endif %}",
                    "spacing": "None"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "REINICIO",
                    "size": "Small",
                    "weight": "Bolder",
                    "color": "{% if results.post_validation.reboot.required | default(false) %}Warning{% else %}Good{% endif %}",
                    "spacing": "None"
                  },
                  {
                    "type": "TextBlock",
                    "text": "{% if results.post_validation.reboot.required | default(false) %}SÍ{% else %}NO{% endif %}",
                    "size": "ExtraLarge",
                    "weight": "Bolder",
                    "color": "{% if results.post_validation.reboot.required | default(false) %}Warning{% else %}Good{% endif %}",
                    "spacing": "None"
                  }
                ]
              }
            ]
          },

          {% if not _overall_ok | bool %}
          {
            "type": "TextBlock",
            "text": "⚠ Punto de fallo: {% if not results.pre_validation.can_continue %}Validación Previa{% elif not results.repo_config.can_continue %}Configuración de Repositorio{% elif not results.patching.can_continue %}Proceso de Parchado{% else %}Validación Post-Parchado{% endif %}",
            "size": "Small",
            "weight": "Bolder",
            "color": "Attention",
            "separator": true,
            "spacing": "Medium"
          },
          {% endif %}

          {
            "type": "TextBlock",
            "text": "Inicio: {{ results.pre_validation.timestamp }}  ·  Fin: {{ results.post_validation.timestamp }}",
            "size": "Small",
            "isSubtle": true,
            "separator": true,
            "spacing": "Medium"
          }

        ],
        "actions": [
          {
            "type": "Action.OpenUrl",
            "title": "Ver Informe HTML",
            "url": "{{ informe_url | default('file://' + log_dir + '/' + crq_input | upper + '/' + inventory_hostname + '/' + informe_filename) }}"
          }
          {% if aap_job_url is defined and aap_job_url | length > 0 %},
          {
            "type": "Action.OpenUrl",
            "title": "Ver Job en AAP",
            "url": "{{ aap_job_url }}"
          }
          {% endif %}
        ]
      }
    }
  ]
}