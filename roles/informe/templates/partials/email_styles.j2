body {
    font-family: Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #333;
    margin: 0;
    padding: 20px;
    background-color: #f0f4f8;
}
.container {
    max-width: 900px;
    margin: 0 auto;
    background-color: #fff;
    padding: 20px;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}
.header {
    background-color: #0066cc;
    color: white;
    padding: 15px 20px;
    text-align: center;
    margin-bottom: 20px;
    border-radius: 5px;
}
.header h2 { margin: 0; font-size: 18px; }
.header p  { margin: 4px 0 0; font-size: 12px; opacity: 0.85; }

/* ── Banners de estado ── */
.banner-success {
    background-color: #d1edff;
    border: 1px solid #bee5eb;
    border-left: 4px solid #0c5460;
    color: #0c5460;
    padding: 12px 15px;
    margin-bottom: 20px;
    border-radius: 4px;
    font-weight: bold;
}
.banner-error {
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    border-left: 4px solid #721c24;
    color: #721c24;
    padding: 12px 15px;
    margin-bottom: 20px;
    border-radius: 4px;
    font-weight: bold;
}
.banner-warning {
    background-color: #fff3cd;
    border: 1px solid #ffeaa7;
    border-left: 4px solid #856404;
    color: #856404;
    padding: 12px 15px;
    margin-bottom: 20px;
    border-radius: 4px;
    font-weight: bold;
}

/* ── Info boxes ── */
.info-box {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    padding: 15px;
    margin: 15px 0;
    border-radius: 4px;
}
.info-box p.box-title {
    margin: 0 0 10px;
    font-weight: bold;
    font-size: 13px;
    color: #333;
}
.info-box-blue {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-left: 4px solid #0066cc;
    padding: 15px;
    margin: 15px 0;
    border-radius: 4px;
}
.info-box-blue p.box-title {
    margin: 0 0 10px;
    font-weight: bold;
    font-size: 13px;
    color: #0066cc;
}

/* ── Section heading ── */
.section-title {
    font-size: 13px;
    font-weight: bold;
    color: #0066cc;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid #dee2e6;
    padding-bottom: 5px;
    margin: 20px 0 12px;
}

/* ── Stats grid ── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
    margin: 12px 0;
}
.stat-item {
    background-color: #ffffff;
    padding: 15px 10px;
    border: 1px solid #dee2e6;
    text-align: center;
    border-radius: 4px;
}
.stat-value {
    font-size: 28px;
    font-weight: bold;
    color: #0066cc;
    line-height: 1;
}
.stat-value.context-ok    { color: #28a745; }
.stat-value.context-alert { color: #d39e00; }
.stat-value.context-error { color: #dc3545; }
.stat-label {
    font-size: 10px;
    color: #666;
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

/* ── Tables ── */
table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: 12px;
}
th, td {
    border: 1px solid #dee2e6;
    padding: 8px 10px;
    text-align: left;
}
th {
    background-color: #e9ecef;
    font-weight: bold;
    font-size: 11px;
    color: #495057;
    text-transform: uppercase;
}
td.center { text-align: center; }
tr:nth-child(even) { background-color: #f8f9fa; }
tr:hover           { background-color: #e9ecef; }

/* ── Status text ── */
.status-ok      { color: #28a745; font-weight: bold; }
.status-error   { color: #dc3545; font-weight: bold; }
.status-skipped { color: #ffc107; font-weight: bold; }
.status-warn    { color: #856404; font-weight: bold; }

/* ── Status badge (inline) ── */
.badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.badge-ok      { background-color: #d4edda; color: #155724; }
.badge-error   { background-color: #f8d7da; color: #721c24; }
.badge-skipped { background-color: #fff3cd; color: #856404; }
.badge-warn    { background-color: #fff3cd; color: #856404; }

/* ── Filesystem bars ── */
.fs-bar-track {
    background-color: #dee2e6;
    border-radius: 3px;
    height: 8px;
    width: 100%;
    margin-top: 4px;
}
.fs-bar-fill {
    height: 8px;
    border-radius: 3px;
}
.fs-bar-ok   { background-color: #28a745; }
.fs-bar-fail { background-color: #dc3545; }

/* ── Pill tags ── */
.pill-wrap { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
.pill {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 99px;
    font-size: 10px;
    font-family: 'Courier New', monospace;
    border: 1px solid #dee2e6;
    background-color: #f8f9fa;
    color: #495057;
}
.pill-update { border-color: #93c5fd; background-color: #eff6ff; color: #1d4ed8; }
.pill-new    { border-color: #86efac; background-color: #f0fdf4; color: #15803d; }
.pill-del    { border-color: #fca5a5; background-color: #fef2f2; color: #b91c1c; }

/* ── Reboot banner ── */
.reboot-required {
    background-color: #fff3cd;
    border-left: 4px solid #856404;
    color: #856404;
    padding: 10px 15px;
    border-radius: 4px;
    margin-top: 10px;
    font-size: 13px;
}
.reboot-ok {
    background-color: #d4edda;
    border-left: 4px solid #28a745;
    color: #155724;
    padding: 10px 15px;
    border-radius: 4px;
    margin-top: 10px;
    font-size: 13px;
}

/* ── Code ── */
code {
    background-color: #f4f4f4;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #c7254e;
}

/* ── Footer ── */
.footer {
    border-top: 2px solid #dee2e6;
    padding-top: 15px;
    margin-top: 30px;
    text-align: center;
    color: #666;
    font-size: 11px;
}
.team-name {
    color: #0066cc;
    font-weight: bold;
    font-size: 13px;
}

ul { margin: 8px 0; padding-left: 22px; }
li { margin: 4px 0; font-size: 13px; }